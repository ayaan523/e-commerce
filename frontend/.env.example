# Google OAuth Configuration
# Get this from Google Cloud Console (https://console.cloud.google.com)
# 1. Create an OAuth 2.0 Client ID (Web application)
# 2. Add http://localhost:5173 as an authorized redirect URI for local development
# 3. For production, add your actual domain (https://yourdomain.com)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# API Configuration
# For local development with backend on localhost
VITE_API_URL=http://localhost:5000

# For production, use your actual backend domain
# VITE_API_URL=https://api.yourdomain.com
