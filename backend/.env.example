# Database Configuration
MONGO_URI=mongodb://database:27017/luxury_ecommerce

# Google OAuth Configuration (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Admin Authentication (set secure random values in production)
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_TOKEN_SECRET=your_secure_token_secret_here_min_32_chars

# Comma-separated list of admin email addresses allowed to access the admin panel
ADMIN_EMAILS=admin@example.com,another.admin@example.com

# Razorpay Payment Gateway (get from Razorpay Dashboard)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Server Configuration
PORT=5000
